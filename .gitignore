# competition data, caches and labels derived from reports: never versioned (rule 2.4.b)
data/
# local environments, logs, model weights (runs/ keeps configs, metrics and out-of-fold predictions)
.venv/
.venv-llm/
.venv-p100/
logs/
runs/*/checkpoints/
*.pt
*.pth
*.ckpt
*.pkl
__pycache__/
*.pyc
.ipynb_checkpoints/
# Kaggle upload staging and third-party wheels (rebuilt by scripts/package_kaggle.py / pip download)
kaggle/_dataset/
kaggle/wheels/
runs/_smoke/
# blend notebook: built by scripts/build_blend_nb.py from a public notebook (third-party code, Apache 2.0):
# kaggle kernels pull yamadan96/rsna-knee-d4-public0946 -p kaggle/blend && mv kaggle/blend/rsna-knee-d4-public0946.ipynb kaggle/blend/public_src.ipynb
kaggle/blend/*.ipynb
kaggle/blend_w25/*.ipynb
